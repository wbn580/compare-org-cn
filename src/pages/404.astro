    <h1 style='font-family: "Microsoft YaHei", sans-serif;font-size:clamp(40px,8vw,72px);font-weight:800;color:var(--ink);'>404</h1>
    <p style="margin-top:16px;color:var(--muted);font-size:18px;">页面未找到</p>
    <p style="margin-top:24px;"><a href="/" style="color:var(--accent);font-weight:700;">返回首页 &rarr;</a></p>
  </section>
</BaseLayout>
