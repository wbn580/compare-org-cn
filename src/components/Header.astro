---
<nav class="nav" id="nav">
  <div class="brand">
    <a href="/" class="brand" style="color:inherit;display:flex;">
      <div class="mark">比</div>
      <div class="title"><b>对比研究室</b><span>COMPARE.ORG.CN</span></div>
    </a>
  </div>
  <div class="nav-links" data-cw-nav id="cw-navlinks">
    <a href="/#dim">评测维度</a>
    <a href="/#articles">最新横评</a>
    <a href="/tags/">Topics</a>
    <a href="/about">评测方法</a>
  </div>
  <a href="/about" class="nav-cta">了解我们</a>
  <div class="hamb" id="hamb" data-cw-burger aria-controls="cw-navlinks" aria-expanded="false" role="button" tabindex="0" aria-label="打开主导航"><span></span><span></span><span></span></div>
</nav>

<script>
  const nav = document.getElementById('nav');
  const hamb = document.getElementById('hamb');
  function onScroll() {
    const y = window.scrollY;
    nav.classList.toggle('scrolled', y > window.innerHeight * 0.7);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  hamb.addEventListener('click', () => {
    const links = nav.querySelector('.nav-links') as HTMLElement;
    if (links) {
      links.style.display = links.style.display === 'flex' ? 'none' : 'flex';
      links.style.position = 'absolute';
      links.style.top = '100%';
      links.style.left = '0';
      links.style.right = '0';
      links.style.flexDirection = 'column';
      links.style.gap = '0';
      links.style.background = 'rgba(26,31,43,.97)';
      links.style.padding = '16px';
      links.style.backdropFilter = 'blur(12px)';
      (links.style as any).WebkitBackdropFilter = 'blur(12px)';
    }
  });
</script>

<style>


  /* MENU-CROWD-FIX-20260708: keep dense desktop menus from wrapping or crushing CTA buttons. */
  header nav a,
  .nav-links a,
  .nav-link,
  .nav-cta,
  .site-nav a {
    white-space: nowrap;
  }
  .nav-links,
  .site-nav {
    min-width: 0;
  }
  .site-nav.flex-wrap,
  nav.site-nav.flex-wrap {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .site-nav.flex-wrap::-webkit-scrollbar,
  nav.site-nav.flex-wrap::-webkit-scrollbar {
    display: none;
  }


  /* MENU-CROWD-FIX-20260708-OVERFLOW: fallback for nav bars without a hamburger variant. */
  @media (max-width: 1120px) {
    header nav,
    .nav-links {
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    header nav::-webkit-scrollbar,
    .nav-links::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  // 2026-09-01 手机主导航不可达修复：给汉堡按钮接上真正的开合处理器。
  (() => {
    const b = document.querySelector('[data-cw-burger]');
    const n = document.querySelector('[data-cw-nav]');
    if (!b || !n) return;
    const bar = b.closest('nav') || b.closest('header') || b.parentElement;
    const place = () => {
      const r = bar.getBoundingClientRect();
      n.style.top = Math.max(0, r.bottom) + 'px';
    };
    const set = (open) => {
      if (open) place();
      n.classList.toggle('cw-open', open);
      b.setAttribute('aria-expanded', String(open));
      b.setAttribute('aria-label', open ? '\u5173\u95ed\u4e3b\u5bfc\u822a' : '\u6253\u5f00\u4e3b\u5bfc\u822a');
    };
    const toggle = () => set(!n.classList.contains('cw-open'));
    b.addEventListener('click', toggle);
    b.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
    n.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
    window.addEventListener('resize', () => { if (n.classList.contains('cw-open')) place(); });
  })();
</script>
