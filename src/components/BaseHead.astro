---
import '../styles/global.css';
const { title, description = '跨品类综合产品/服务横评 — 家电、SaaS、服务商、学校、信用卡等数百品类深度对比评测，用数据说话让每一次消费决策都有据可依', image } = Astro.props as { title: string; description?: string; image?: string };
const siteUrl = 'https://compare.org.cn';
const ogImage = image || 'https://compare.org.cn/og-image.jpg';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={canonical} />
<title>{(title === '对比研究室' || title.includes('对比研究室')) ? title : `${title} · 对比研究室`}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="对比研究室" />
<meta property="og:type" content="article" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content="#1a1f2b" />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "对比研究室",
  "url": siteUrl,
  "description": "跨品类综合产品/服务横评，覆盖家电、SaaS、服务商、学校、信用卡等数百品类，数据驱动独立评测",
  "publisher": {
    "@type": "Organization",
    "name": "对比研究室",
    "url": siteUrl
  }
})} />
